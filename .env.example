# Configuración del servidor Web
HOST=0.0.0.0
PORT=8000

# Conexión con Ollama
# Para ejecución local fuera de docker: http://localhost:11434
# Para docker compose con servicio ollama: http://ollama:11434
# Para docker apuntando a ollama del host: http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434

# Hilos de computación CPU
OMP_NUM_THREADS=2
MKL_NUM_THREADS=2
OPENBLAS_NUM_THREADS=2

